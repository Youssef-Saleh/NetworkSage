# NetworkSage-X configuration
# Copy to .env and fill in real keys. Never commit .env.

# Model serving
HF_TOKEN=hf_xxx
HUGGINGFACEHUB_API_TOKEN=hf_xxx
NETWORKSAGE_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
NETWORKSAGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NETWORKSAGE_IOC_MODEL=dslim/bert-base-NER

# Local LLM (optional, used when HF_TOKEN is not set)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Threat intel APIs (free tiers available)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=
GREYNOISE_API_KEY=
NVD_API_KEY=

# MITRE ATT&CK STIX
MITRE_STIX_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

# Observability (LangSmith / LangFuse)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=networksage-x
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Database
DATABASE_URL=postgresql+psycopg://networksage:networksage@localhost:5432/networksage

# App
NETWORKSAGE_LOG_LEVEL=INFO
NETWORKSAGE_ENV=development